# Copy to .env.local and fill in. Read at build time.

# The site's public address, without a trailing slash. Used for the canonical link, the sitemap,
# robots.txt and the social image, for example https://your-domain.com. Vercel and Netlify fill it in on their own
# if you leave it empty; elsewhere `npm run build` warns until it is set.
NEXT_PUBLIC_SITE_URL=
